{
  "id": "claude",
  "version": "1.0.0",
  "api_version": 1,
  "types": [
    "integration"
  ],
  "root": "scripts/extensions/claude",
  "read_roots": [
    ".ai"
  ],
  "write_roots": [
    "CLAUDE.md",
    ".claude"
  ],
  "platforms": [
    "any"
  ],
  "integration": {
    "format": "claude",
    "agent_document": ".ai/agents/reviewer.md",
    "command_catalog_source": ".ai/skills/pr-blueprint/command-catalog.json",
    "catalogs": {
      "qa_rules": {
        "title": "QA Rules",
        "source_root": ".ai/rules",
        "include": null,
        "exclude": []
      },
      "review_workflows": {
        "title": "Review Workflows",
        "source_root": ".ai/workflows",
        "include": [
          "learn.md",
          "qa.md",
          "review.md"
        ],
        "exclude": []
      }
    },
    "argument_placeholder": "<task_id>",
    "generated_file_extension": ".md",
    "invoke_separator": " ",
    "detect_marker": "CLAUDE.md",
    "commands": {
      "ARCHIVE": "ai archive",
      "AUDIT_FRAMEWORK": "ai audit-framework",
      "BLUEPRINT": "ai blueprint",
      "CARGO": "ai cargo",
      "CARGO_CACHE": "ai cargo-cache",
      "DISPATCH": "ai dispatch",
      "DOCS": "ai docs",
      "FEATURE": "ai feature",
      "INIT": "ai init",
      "LEARN": "ai learn",
      "MERGE": "ai merge",
      "PLAN": "ai plan",
      "QA": "ai qa",
      "RESEARCH": "ai research",
      "REVIEW": "ai review",
      "SKILLS": "ai skills",
      "SKILLS_ADD": "ai skills add",
      "SKILLS_LIST": "ai skills list",
      "SKILLS_REMOVE": "ai skills remove",
      "SYNC": "ai sync",
      "TASK": "ai task",
      "TASKS": "ai tasks",
      "VERIFY": "ai verify"
    },
    "render": {
      "artifacts": [
        {
          "kind": "marker_document",
          "path": "CLAUDE.md",
          "template": "templates/CLAUDE.md.tmpl"
        },
        {
          "kind": "support_document",
          "path": ".claude/README.md",
          "template": "templates/README.md.tmpl"
        },
        {
          "kind": "settings_document",
          "path": ".claude/settings.json",
          "document": {
            "_generated_warning": "{generated_warning}",
            "agent_control_plane": {
              "canonical_root": ".ai",
              "default_role": "{tool_role}",
              "default_isolation": "{default_isolation}"
            }
          }
        },
        {
          "kind": "command_document",
          "path": ".claude/commands/dispatch.md",
          "template": "templates/commands/dispatch.md.tmpl",
          "invocation": {
            "token": "DISPATCH",
            "arguments": [
              "{argument_placeholder}",
              "--tool",
              "{tool}"
            ]
          }
        },
        {
          "kind": "command_document",
          "path": ".claude/commands/review.md",
          "template": "templates/commands/review.md.tmpl",
          "invocation": {
            "token": "REVIEW",
            "arguments": [
              "{argument_placeholder}",
              "--tool",
              "{tool}"
            ]
          }
        },
        {
          "kind": "command_document",
          "path": ".claude/commands/qa.md",
          "template": "templates/commands/qa.md.tmpl",
          "invocation": {
            "token": "QA",
            "arguments": [
              "{argument_placeholder}"
            ]
          }
        },
        {
          "kind": "rules_tree",
          "source_root": ".ai/workflows",
          "destination": ".claude/workflows",
          "strip_frontmatter": true,
          "legacy_aliases": []
        }
      ]
    }
  }
}
